#!/bin/sh

echo "🔍 Running pre-push checks..."

echo "\n[1/3] ESLint (zero warnings allowed)..."
yarn lint
if [ $? -ne 0 ]; then
  echo "❌ ESLint failed. Fix all errors/warnings before pushing."
  exit 1
fi

echo "\n[2/3] TypeScript type check..."
npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo "❌ TypeScript errors found. Fix them before pushing."
  exit 1
fi

echo "\n[3/3] Production build..."
yarn build
if [ $? -ne 0 ]; then
  echo "❌ Build failed. Fix build errors before pushing."
  exit 1
fi

echo "\n✅ All checks passed! Pushing to GitHub..."
