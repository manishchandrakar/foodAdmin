echo "Running pre-push checks..."

echo "[1/3] Backend checks..."
cd backend
yarn lint
if [ $? -ne 0 ]; then
  echo "Backend ESLint failed."
  exit 1
fi
npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo "Backend TypeScript errors found."
  exit 1
fi
cd ..

echo "[2/3] Admin checks..."
cd admin
yarn lint
if [ $? -ne 0 ]; then
  echo "Admin ESLint failed."
  exit 1
fi
npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo "Admin TypeScript errors found."
  exit 1
fi
cd ..

echo "[3/3] Frontend checks..."
cd frontend
yarn lint
if [ $? -ne 0 ]; then
  echo "Frontend ESLint failed."
  exit 1
fi
npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo "Frontend TypeScript errors found."
  exit 1
fi
cd ..

echo "All pre-push checks passed."
